# Optional: enables LLM-based bullish/bearish classification via Groq's
# free API (Llama 3) instead of the local VADER-only heuristic.
# Get a free key at https://console.groq.com -> API Keys.
# Leave unset and the app falls back to VADER automatically.
GROQ_API_KEY=

# Optional: override the Groq model (defaults to llama-3.1-8b-instant).
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: comma-separated list of frontend origins allowed to call this
# API with credentials (cookies). Defaults to
# http://localhost:5173,https://marketnews-seven.vercel.app - update this
# (or set the env var in the Vercel project settings, no redeploy needed)
# whenever the deployed frontend's URL changes.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Required in any deployment with more than one server process/container
# (e.g. Vercel, which runs multiple isolated serverless instances). Signs
# OTPs and session tokens so any instance can verify them without shared
# storage. MUST be the same fixed value across every instance - generate
# once with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Safe to leave unset for single-process local dev (falls back to an
# insecure placeholder, logged as a warning).
AUTH_SECRET=

# Optional: enables actually emailing the login OTP instead of showing it
# on the login screen ("dev mode"). Tries Resend first, then falls back to
# Gmail SMTP if RESEND_API_KEY isn't set.

# Resend (https://resend.com - free tier, just an API key, no domain needed
# if sending from the onboarding@resend.dev sandbox address):
RESEND_API_KEY=
# RESEND_FROM=MarketPulse <onboarding@resend.dev>

# Gmail SMTP fallback:
# 1. Turn on 2-Step Verification on the sending Google account (can be the
#    same address you're logging in as, or a different one).
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
#    (16-character code, not your normal Gmail password).
# 3. Set both vars below. Leave unset and it falls back to dev mode.
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional: only needed if not using Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
