# Optional: enables LLM-based bullish/bearish classification via Groq's
# free API (Llama 3) instead of the local VADER-only heuristic.
# Get a free key at https://console.groq.com -> API Keys.
# Leave unset and the app falls back to VADER automatically.
GROQ_API_KEY=

# Optional: override the Groq model (defaults to llama-3.1-8b-instant).
# GROQ_MODEL=llama-3.1-8b-instant
